{
  "manifest_version": 3,
  "name": "obsig",
  "version": "1.0.2",
  "description": "Inspecciona seguidores, seguidos, mutuals y rogados (no te siguen de vuelta) usando las cookies de tu navegador.",
  "permissions": [
    "cookies",
    "storage",
    "declarativeNetRequest"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "gs.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://images.weserv.nl/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https:;"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}